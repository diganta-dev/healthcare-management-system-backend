```ejs
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Your Password</title>
</head>

<body style="margin:0; padding:0; background-color:#f3f6fa; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">

  <div style="width:100%; padding:40px 15px; box-sizing:border-box;">

    <div style="max-width:520px; margin:0 auto; background-color:#ffffff; border-radius:12px; overflow:hidden;">

      <!-- Header -->
      <div style="background-color:#2563eb; padding:28px 30px; text-align:center;">

        <h1 style="margin:0; color:#ffffff; font-size:24px; font-weight:700;">
          <%= appName %>
        </h1>

        <p style="margin:8px 0 0; color:#dbeafe; font-size:13px;">
          Password Reset Request
        </p>

      </div>

      <!-- Content -->
      <div style="padding:35px 30px;">

        <h2 style="margin:0 0 12px; font-size:21px; color:#111827;">
          Hello <%= name || "there" %>,
        </h2>

        <p style="margin:0 0 20px; font-size:15px; line-height:1.7; color:#6b7280;">
          We received a request to reset the password for your account.
          Use the verification code below to continue resetting your password.
        </p>

        <!-- OTP -->
        <div style="background-color:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:22px; text-align:center;">

          <p style="margin:0 0 10px; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:1px;">
            Password Reset Code
          </p>

          <p style="margin:0; font-size:36px; font-weight:700; letter-spacing:8px; color:#2563eb;">
            <%= otp %>
          </p>

        </div>

        <!-- Expiration -->
        <p style="margin:16px 0 0; text-align:center; font-size:13px; color:#dc2626;">
          This code expires in
          <strong><%= expiresIn %></strong>.
        </p>

        <!-- Security Notice -->
        <div style="margin-top:25px; padding:16px; background-color:#fff7ed; border-left:4px solid #f97316; border-radius:6px;">

          <p style="margin:0 0 6px; font-size:13px; font-weight:700; color:#9a3412;">
            Security Notice
          </p>

          <p style="margin:0; font-size:13px; line-height:1.6; color:#7c2d12;">
            Never share this code with anyone.
            Our team will never ask you for your OTP or password.
          </p>

        </div>

        <!-- Didn't Request -->
        <p style="margin:25px 0 0; font-size:13px; line-height:1.6; color:#6b7280; text-align:center;">
          If you did not request a password reset, you can safely ignore this email.
          Your account remains secure.
        </p>

      </div>

      <!-- Footer -->
      <div style="border-top:1px solid #e5e7eb; padding:20px 30px; text-align:center;">

        <p style="margin:0; font-size:12px; line-height:1.6; color:#9ca3af;">

          <strong style="color:#6b7280;">
            <%= appName %>
          </strong>

          <br>

          This is an automated email. Please do not reply.

          <br><br>

          © <%= new Date().getFullYear() %>
          <%= appName %>.
          All rights reserved.

        </p>

      </div>

    </div>

  </div>

</body>
</html>
```
 